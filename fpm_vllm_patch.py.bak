import torch
import torch.nn.functional as F
from torch import nn, Tensor
from typing import Optional, Tuple, Union, List, Dict, Any, Iterable, Set, Callable
from dataclasses import dataclass, field
from contextlib import contextmanager
import re
from collections import defaultdict

# Global variable to store original methods for restoration
_ORIGINAL_METHODS = {}

# Global variable to track which model paths need FPM conversion
_FPM_MODEL_PATHS = set()

# Global variable to track if Ascend MoE has been patched
_ASCEND_MOE_PATCHED = False

class FpmRoutingContext:
    """Context manager for FPM routing parameters and loss tracking."""
    
    def __init__(self):
        self.experts_mask = None
        self.gold_gating_idc = None
        self.gating_loss = None
        
    def set_experts_mask(self, experts_mask: torch.Tensor):
        """Set the experts mask for routing."""
        self.experts_mask = experts_mask
        
    def set_gold_gating_idc(self, gold_gating_idc: torch.Tensor):
        """Set the gold gating indices for loss calculation."""
        self.gold_gating_idc = gold_gating_idc
        
    def get_gating_loss(self):
        """Get the accumulated gating loss."""
        return self.gating_loss
    
    def reset_loss(self):
        """Reset the gating loss."""
        self.gating_loss = torch.tensor(0.0)

# Global context instance
_fpm_context = FpmRoutingContext()


def _create_ascend_forward_oot_with_ep_support():
    """Create a new forward_oot implementation based on vllm-ascend source that supports EP parameters."""
    
    # Import the group_topk and fused_experts functions from vllm-ascend
    try:
        # Try to import from installed vllm-ascend
        from vllm_ascend.ops.fused_moe import group_topk, fused_experts
        print("[FPM Patch] Using installed vllm-ascend functions")
    except ImportError:
        # Fallback: use our own implementation if needed
        print("[FPM Patch] vllm-ascend not available, will use fallback implementation")
        
        def group_topk(hidden_states, gating_output, topk, renormalize, 
                      num_expert_group=0, topk_group=0, scoring_func="softmax", 
                      e_score_correction_bias=None):
            # Simplified fallback implementation
            import torch
            import torch.nn.functional as F
            
            if scoring_func == "softmax":
                scores = F.softmax(gating_output, dim=-1)
            else:
                scores = gating_output.sigmoid()
                
            topk_weights, topk_ids = torch.topk(scores, k=topk, dim=-1, sorted=False)
            
            if renormalize:
                topk_weights = topk_weights / topk_weights.sum(dim=-1, keepdim=True)
                
            return topk_weights, topk_ids.to(torch.int32)
        
        def fused_experts(hidden_states, w1, w2, topk_weights, topk_ids, top_k):
            # This should use the NPU implementation, but for now just raise an error
            raise RuntimeError("NPU fused_experts implementation not available")
    
    def forward_oot_with_ep_support(
            self,
            layer: torch.nn.Module,
            x: torch.Tensor,
            use_grouped_topk: bool,
            top_k: int,
            router_logits: torch.Tensor,
            renormalize: bool,
            topk_group: Optional[int] = None,
            num_expert_group: Optional[int] = None,
            custom_routing_function: Optional[Callable] = None,
            scoring_func: str = "softmax",
            e_score_correction_bias: Optional[torch.Tensor] = None,
            # Add the missing EP parameters
            global_num_experts: int = -1,
            expert_map: Optional[torch.Tensor] = None,
            activation: str = "silu",
            **kwargs
    ) -> torch.Tensor:
        
        # Log EP parameters for debugging
        if global_num_experts != -1:
            print(f"[FPM Patch] forward_oot called with global_num_experts={global_num_experts}")
        if expert_map is not None:
            print(f"[FPM Patch] Expert Parallelism active with expert_map shape: {expert_map.shape}")
        
        # Use custom routing if provided (for FPM support)
        if custom_routing_function is not None:
            print("[FPM Patch] Using custom routing function")
            topk_weights, topk_ids = custom_routing_function(
                hidden_states=x,
                gating_output=router_logits,
                topk=top_k,
                renormalize=renormalize
            )
        else:
            # Use vllm-ascend's group_topk
            topk_weights, topk_ids = group_topk(
                hidden_states=x,
                gating_output=router_logits,
                topk=top_k,
                renormalize=renormalize,
                num_expert_group=num_expert_group,
                topk_group=topk_group,
                scoring_func=scoring_func,
                e_score_correction_bias=e_score_correction_bias
            )

        return fused_experts(
            hidden_states=x,
            w1=layer.w13_weight,
            w2=layer.w2_weight,
            topk_weights=topk_weights,
            topk_ids=topk_ids,
            top_k=top_k
        )
    
    return forward_oot_with_ep_support


def _force_patch_ascend_forward_oot():
    """Force patch vllm-ascend's forward_oot after it has been loaded."""
    try:
        from vllm.model_executor.layers.fused_moe.layer import UnquantizedFusedMoEMethod
        
        # Store the original (vllm-ascend's version)
        if 'vllm_ascend_forward_oot' not in _ORIGINAL_METHODS:
            _ORIGINAL_METHODS['vllm_ascend_forward_oot'] = UnquantizedFusedMoEMethod.forward_oot
            print("[FPM Patch] Stored vllm-ascend's forward_oot implementation")
        
        # Replace with our EP-supporting version
        new_forward_oot = _create_ascend_forward_oot_with_ep_support()
        UnquantizedFusedMoEMethod.forward_oot = new_forward_oot
        
        print("[FPM Patch] ✅ FORCE-PATCHED vllm-ascend's forward_oot with EP support")
        return True
        
    except Exception as e:
        print(f"[FPM Patch] ❌ Failed to force-patch vllm-ascend forward_oot: {e}")
        import traceback
        traceback.print_exc()
        return False


def _patched_ascend_forward_oot_with_ep_support(original_forward_oot):
    """Patch vllm-ascend's forward_oot to properly support global_num_experts parameter."""
    def wrapper(
        self,
        layer: torch.nn.Module,
        x: torch.Tensor,
        use_grouped_topk: bool,
        top_k: int,
        router_logits: torch.Tensor,
        renormalize: bool,
        topk_group: Optional[int] = None,
        num_expert_group: Optional[int] = None,
        custom_routing_function: Optional[Callable] = None,
        scoring_func: str = "softmax",
        e_score_correction_bias: Optional[torch.Tensor] = None,
        # Add support for missing parameters
        global_num_experts: int = -1,
        expert_map: Optional[torch.Tensor] = None,
        activation: str = "silu",
        **kwargs
    ) -> torch.Tensor:
        
        # Calculate global_num_experts if not provided
        if global_num_experts == -1:
            # Infer from layer weights
            if hasattr(layer, 'w13_weight') and layer.w13_weight is not None:
                global_num_experts = layer.w13_weight.shape[0]
                print(f"[FPM Patch] Calculated global_num_experts from layer weights: {global_num_experts}")
            else:
                # Fallback: infer from router_logits
                global_num_experts = router_logits.shape[-1]
                print(f"[FPM Patch] Calculated global_num_experts from router_logits: {global_num_experts}")
        
        # Log EP status
        if expert_map is not None:
            print(f"[FPM Patch] Expert Parallelism active with expert_map shape: {expert_map.shape}")
        else:
            print(f"[FPM Patch] Running without Expert Parallelism, all {global_num_experts} experts on local device")
        
        # Call original with only the parameters it supports
        try:
            return original_forward_oot(
                self,
                layer=layer,
                x=x,
                use_grouped_topk=use_grouped_topk,
                top_k=top_k,
                router_logits=router_logits,
                renormalize=renormalize,
                topk_group=topk_group,
                num_expert_group=num_expert_group,
                custom_routing_function=custom_routing_function,
                scoring_func=scoring_func,
                e_score_correction_bias=e_score_correction_bias
            )
        except Exception as e:
            print(f"[FPM Patch] Error in ascend forward_oot: {e}")
            raise
    
    return wrapper


def _patch_ascend_fused_moe_compatibility():
    """Patch vllm-ascend's UnquantizedFusedMoEMethod.forward_oot to properly support EP parameters."""
    global _ASCEND_MOE_PATCHED
    
    if _ASCEND_MOE_PATCHED:
        return
    
    try:
        # Import after vllm-ascend has been loaded
        from vllm.model_executor.layers.fused_moe.layer import UnquantizedFusedMoEMethod
        
        # Check if vllm-ascend has already replaced forward_oot
        if hasattr(UnquantizedFusedMoEMethod, 'forward_oot'):
            # Store original method
            if 'UnquantizedFusedMoEMethod.forward_oot' not in _ORIGINAL_METHODS:
                _ORIGINAL_METHODS['UnquantizedFusedMoEMethod.forward_oot'] = UnquantizedFusedMoEMethod.forward_oot
                
                # Apply our EP-supporting patch
                UnquantizedFusedMoEMethod.forward_oot = _patched_ascend_forward_oot_with_ep_support(
                    UnquantizedFusedMoEMethod.forward_oot
                )
                _ASCEND_MOE_PATCHED = True
                
                print("[FPM Patch] ✅ vllm-ascend UnquantizedFusedMoEMethod.forward_oot patched with Expert Parallelism support")
        else:
            print("[FPM Patch] ⚠️  UnquantizedFusedMoEMethod.forward_oot not found, vllm-ascend may not be loaded")
            
    except Exception as e:
        print(f"[FPM Patch] ❌ Failed to patch vllm-ascend forward_oot: {e}")
        import traceback
        traceback.print_exc()


def _patched_custom_op_forward_oot(original_forward_oot):
    """Patch CustomOp.forward_oot to handle parameter compatibility issues."""
    def wrapper(self, *args, **kwargs):
        # Filter out parameters that vllm-ascend doesn't support yet
        filtered_kwargs = kwargs.copy()
        
        # Remove global_num_experts if it exists, as vllm-ascend doesn't support it yet
        if 'global_num_experts' in filtered_kwargs:
            print(f"[FPM Patch] Removing unsupported parameter 'global_num_experts' for vllm-ascend compatibility")
            filtered_kwargs.pop('global_num_experts')
        
        # Call original with filtered parameters
        return original_forward_oot(self, *args, **filtered_kwargs)
    
    return wrapper


def _patch_custom_op_for_ascend_compatibility():
    """Patch CustomOp.forward_oot to handle vllm-ascend compatibility issues."""
    global _ASCEND_MOE_PATCHED
    
    if _ASCEND_MOE_PATCHED:
        return
    
    try:
        from vllm.model_executor.custom_op import CustomOp
        
        # Store original method
        if 'CustomOp.forward_oot' not in _ORIGINAL_METHODS:
            _ORIGINAL_METHODS['CustomOp.forward_oot'] = CustomOp.forward_oot
            
            # Apply patch
            CustomOp.forward_oot = _patched_custom_op_forward_oot(CustomOp.forward_oot)
            _ASCEND_MOE_PATCHED = True
            
            print("[FPM Patch] ✅ CustomOp.forward_oot patched for vllm-ascend compatibility")
    except Exception as e:
        print(f"[FPM Patch] ❌ Failed to patch CustomOp.forward_oot: {e}")


@contextmanager
def fpm_routing_context(**kwargs):
    """Context manager for FPM routing."""
    global _fpm_context
    
    # Set parameters if provided
    if 'experts_mask' in kwargs:
        _fpm_context.set_experts_mask(kwargs['experts_mask'])
    if 'gold_gating_idc' in kwargs:
        _fpm_context.set_gold_gating_idc(kwargs['gold_gating_idc'])
    
    # Reset loss at start
    _fpm_context.reset_loss()
    
    try:
        yield _fpm_context
    finally:
        # Cleanup if needed
        _fpm_context.experts_mask = None
        _fpm_context.gold_gating_idc = None


def fpm_custom_routing_function(
    hidden_states: torch.Tensor,
    gating_output: torch.Tensor,
    topk: int,
    renormalize: bool
) -> Tuple[torch.Tensor, torch.Tensor]:
    """
    Custom routing function for FPM that supports experts masking and loss calculation.
    """
    global _fpm_context
    
    # Apply experts mask if provided
    if _fpm_context.experts_mask is not None:
        # Get the correct dimensions - gating_output is [total_tokens, num_experts]
        total_tokens, num_experts = gating_output.shape
        
        # Ensure experts_mask is on the same device as gating_output
        experts_mask = _fpm_context.experts_mask.to(gating_output.device)
        
        # Handle different expert mask formats for continuous batching
        if experts_mask.dim() == 1:  # [total_tokens,] - single mask per token
            if experts_mask.shape[0] == total_tokens:
                # Expand to [total_tokens, num_experts] 
                experts_mask = experts_mask.unsqueeze(1).expand(-1, num_experts)
            else:
                print(f"[FPM] ❌ experts_mask dim=1 size mismatch: {experts_mask.shape[0]} vs {total_tokens}")
                experts_mask = None
        elif experts_mask.dim() == 2:  # Could be [total_tokens, num_experts] or [batch_size, num_experts]
            if experts_mask.shape == gating_output.shape:
                # Perfect match, use as-is
                pass
            elif experts_mask.shape[1] == num_experts:
                # Use cyclic indexing for continuous batching
                batch_size = experts_mask.shape[0]
                
                # Create indices for cyclic access
                indices = torch.arange(total_tokens, device=experts_mask.device) % batch_size
                experts_mask = experts_mask[indices]  # [total_tokens, num_experts]
                print(f"[FPM] ✅ Applied experts_mask via cyclic indexing: {batch_size} → {total_tokens}")
            else:
                print(f"[FPM] ❌ experts_mask shape {experts_mask.shape} incompatible with gating_output {gating_output.shape}")
                experts_mask = None
        else:
            print(f"[FPM] ❌ Unsupported experts_mask dimensions: {experts_mask.dim()}")
            experts_mask = None
            
        # Apply mask if successfully processed
        if experts_mask is not None and experts_mask.shape == gating_output.shape:
            # Apply mask (add large negative values to masked experts)
            gating_output = gating_output + experts_mask
        elif experts_mask is not None:
            print(f"[FPM] ❌ Final shape mismatch: experts_mask {experts_mask.shape} vs gating_output {gating_output.shape}")
    
    # Calculate gating loss if gold indices provided
    if _fpm_context.gold_gating_idc is not None:
        # Get the correct dimensions - gating_output is [total_tokens, num_experts]
        total_tokens, num_experts = gating_output.shape
        
        # Ensure target_experts is on the same device as gating_output
        target_experts = _fpm_context.gold_gating_idc.to(gating_output.device)
        
        # Handle different gold indices formats for continuous batching
        if target_experts.dim() == 1:  # [total_tokens,] - single target per token
            if target_experts.shape[0] == total_tokens:
                # Expand to [total_tokens, num_experts] 
                target_experts = target_experts.unsqueeze(1).expand(-1, num_experts)
            else:
                print(f"[FPM] ❌ target_experts dim=1 size mismatch: {target_experts.shape[0]} vs {total_tokens}")
                target_experts = None
        elif target_experts.dim() == 2:  # Could be [total_tokens, num_experts] or [batch_size, num_experts]
            if target_experts.shape == gating_output.shape:
                # Perfect match, use as-is
                pass
            elif target_experts.shape[1] == num_experts:
                # Use cyclic indexing for continuous batching
                batch_size = target_experts.shape[0]
                
                # Create indices for cyclic access
                indices = torch.arange(total_tokens, device=target_experts.device) % batch_size
                target_experts = target_experts[indices]  # [total_tokens, num_experts]
                print(f"[FPM] ✅ Applied gold_gating_idc via cyclic indexing: {batch_size} → {total_tokens}")
            else:
                print(f"[FPM] ❌ target_experts shape {target_experts.shape} incompatible with gating_output {gating_output.shape}")
                target_experts = None
        else:
            print(f"[FPM] ❌ Unsupported target_experts dimensions: {target_experts.dim()}")
            target_experts = None
            
        # Calculate loss if successfully processed
        if target_experts is not None and target_experts.shape == gating_output.shape:
            # Calculate binary cross entropy loss
            gating_loss = F.binary_cross_entropy_with_logits(
                gating_output, target_experts.float(), reduction="mean"
            )
            
            # Accumulate loss with device checking
            if _fpm_context.gating_loss is None:
                _fpm_context.gating_loss = gating_loss
            else:
                # Ensure same device before adding
                if _fpm_context.gating_loss.device != gating_loss.device:
                    _fpm_context.gating_loss = _fpm_context.gating_loss.to(gating_loss.device)
                
                _fpm_context.gating_loss += gating_loss
        elif target_experts is not None:
            print(f"[FPM] ❌ Final shape mismatch: target_experts {target_experts.shape} vs gating_output {gating_output.shape}")
    
    # Compute top-k routing (simplified version for NPU compatibility)
    routing_weights = F.softmax(gating_output, dim=-1)
    topk_weights, topk_indices = torch.topk(routing_weights, topk, dim=-1)
    
    if renormalize:
        topk_weights = topk_weights / topk_weights.sum(dim=-1, keepdim=True)
    
    # Convert to int32 for vllm-ascend compatibility 
    topk_indices = topk_indices.to(torch.int32)
    
    return topk_weights, topk_indices


def _convert_config_to_moe(config):
    """Convert Qwen2 config to Qwen2MoE config in-place."""
    print(f"[FPM Patch] Checking config: model_type={getattr(config, 'model_type', 'NONE')}, architectures={getattr(config, 'architectures', 'NONE')}")
    
    # Check if conversion is needed
    if hasattr(config, 'model_type') and config.model_type == 'qwen2':
        if hasattr(config, 'architectures') and 'Qwen2ForCausalLM' in config.architectures:
            print("[FPM Patch] Converting Qwen2 config to Qwen2MoE config...")
            
            # Change model type and architecture
            config.model_type = 'qwen2_moe'
            config.architectures = ['Qwen2MoeForCausalLM']
            
            # Add missing MoE parameters
            if not hasattr(config, 'num_experts'):
                if hasattr(config, 'n_routed_experts'):
                    config.num_experts = config.n_routed_experts
                else:
                    config.num_experts = 4  # Default fallback
                    
            if not hasattr(config, 'num_experts_per_tok'):
                config.num_experts_per_tok = 1  # Conservative default
                
            if not hasattr(config, 'moe_intermediate_size'):
                config.moe_intermediate_size = getattr(config, 'intermediate_size', 8960)
                
            if not hasattr(config, 'shared_expert_intermediate_size'):
                config.shared_expert_intermediate_size = getattr(config, 'intermediate_size', 8960)
                
            if not hasattr(config, 'decoder_sparse_step'):
                config.decoder_sparse_step = 1
                
            if not hasattr(config, 'norm_topk_prob'):
                config.norm_topk_prob = False
            
            print(f"[FPM Patch] ✅ Config converted successfully:")
            print(f"[FPM Patch]   model_type: qwen2 -> qwen2_moe")
            print(f"[FPM Patch]   architectures: Qwen2ForCausalLM -> Qwen2MoeForCausalLM")
            print(f"[FPM Patch]   num_experts: {config.num_experts}")
            print(f"[FPM Patch]   num_experts_per_tok: {config.num_experts_per_tok}")
        else:
            print(f"[FPM Patch] No conversion needed - architectures: {getattr(config, 'architectures', 'NONE')}")
    else:
        print(f"[FPM Patch] No conversion needed - model_type: {getattr(config, 'model_type', 'NONE')}")
    
    return config


def _is_fpm_model_path(model_path: str) -> bool:
    """Check if the model path is registered for FPM conversion."""
    global _FPM_MODEL_PATHS
    # Also check if any registered path is a substring/parent of the given path
    str_path = str(model_path)
    for registered_path in _FPM_MODEL_PATHS:
        if registered_path in str_path or str_path in registered_path:
            return True
    return False


def _patched_get_config(original_get_config):
    """Patched get_config function that dynamically converts FPM model configs."""
    def wrapper(model, trust_remote_code, revision=None, code_revision=None, config_format=None, **kwargs):
        print(f"[FPM Patch] get_config called with model: {model}")
        
        # Call original get_config
        config = original_get_config(model, trust_remote_code, revision, code_revision, config_format, **kwargs)
        
        # Convert config if this is an FPM model path
        if _is_fpm_model_path(str(model)):
            print(f"[FPM Patch] Model path matches FPM registration, converting config...")
            config = _convert_config_to_moe(config)
        else:
            print(f"[FPM Patch] Model path not in FPM registry: {_FPM_MODEL_PATHS}")
        
        return config
    
    return wrapper


def _convert_weight_names(weights: Iterable[Tuple[str, torch.Tensor]]) -> Iterable[Tuple[str, torch.Tensor]]:
    """Convert weight names from DeepSpeed format to vLLM format."""
    print("[FPM Patch] Starting weight name conversion...")
    conversion_count = 0
    skipped_count = 0
    
    for name, tensor in weights:
        original_name = name
        new_name = name
        
        try:
            # Skip lm_head.weight when tie_word_embeddings=True (it's handled by embed_tokens.weight)
            if name == "lm_head.weight":
                skipped_count += 1
                print(f"[FPM Patch] Skipping lm_head.weight (handled by tie_word_embeddings)")
                continue
            
            # 1. Convert routed_experts.deepspeed_moe -> mlp
            new_name = new_name.replace("routed_experts.deepspeed_moe", "mlp")
            
            # 2. Convert gate.wg.weight -> gate.weight (for router)
            new_name = new_name.replace("gate.wg.weight", "gate.weight")
            
            # 3. Convert experts.deepspeed_experts -> experts
            new_name = new_name.replace("experts.deepspeed_experts", "experts")
            
            # 4. Convert shared_experts -> mlp.shared_expert
            new_name = new_name.replace("shared_experts", "mlp.shared_expert")
            
            # Note: vLLM expects experts.N.weight_name format (not experts[N])
            # The experts.N format is already correct for vLLM, no conversion needed
            
            # Count conversions for debugging (but not if name didn't change)
            if new_name != original_name:
                conversion_count += 1
                if conversion_count <= 20:  # Show first 20 conversions
                    print(f"[FPM Patch] Weight name conversion {conversion_count}: {original_name} -> {new_name}")
            
            yield (new_name, tensor)
            
        except Exception as e:
            print(f"[FPM Patch] Error processing weight {original_name}: {e}")
            # Continue with original name to avoid stopping the process
            yield (original_name, tensor)
    
    print(f"[FPM Patch] Weight name conversion completed.")
    print(f"[FPM Patch] Total conversions: {conversion_count}, skipped: {skipped_count}")


def _patched_qwen2moeforcausallm_load_weights(self, weights: Iterable[Tuple[str, torch.Tensor]]) -> Set[str]:
    """Patched load_weights that converts weight names."""
    print("[FPM Patch] Qwen2MoeForCausalLM.load_weights called - applying weight name conversion")
    
    try:
        converted_weights = _convert_weight_names(weights)
        loaded_params = _ORIGINAL_METHODS['Qwen2MoeForCausalLM.load_weights'](self, converted_weights)
        
        # Initialize missing shared_expert_gate weights and add them to loaded_params
        initialized_gates = _initialize_missing_shared_expert_gates(self)
        loaded_params.update(initialized_gates)
        
        print("[FPM Patch] ✅ Load weights completed successfully")
        return loaded_params
    except Exception as e:
        print(f"[FPM Patch] ❌ Error in load_weights: {e}")
        import traceback
        traceback.print_exc()
        raise


def _initialize_missing_shared_expert_gates(model):
    """Initialize missing shared_expert_gate weights with reasonable defaults."""
    print("[FPM Patch] Initializing missing shared_expert_gate weights...")
    
    initialized_count = 0
    initialized_names = set()
    
    for name, param in model.named_parameters():
        if 'shared_expert_gate.weight' in name:
            # Initialize to zeros, so sigmoid(0) = 0.5 (use 50% of shared expert)
            with torch.no_grad():
                param.data.zero_()
            initialized_count += 1
            initialized_names.add(name)
            if initialized_count <= 5:  # Show first 5 initializations
                print(f"[FPM Patch] Initialized {name} to zeros (sigmoid -> 0.5)")
    
    print(f"[FPM Patch] Initialized {initialized_count} shared_expert_gate weights")
    return initialized_names


def _patched_qwen2moeattention_forward(self, positions: torch.Tensor, hidden_states: torch.Tensor):
    """
    Patched Qwen2MoeAttention.forward that follows the standard attention pattern.
    This fixes the vLLM native implementation which incorrectly mixed attention and decoder layer logic.
    """
    # This should be the ONLY logic for attention, just like Qwen2Attention
    qkv, _ = self.qkv_proj(hidden_states)
    q, k, v = qkv.split([self.q_size, self.kv_size, self.kv_size], dim=-1)
    q, k = self.rotary_emb(positions, q, k)
    attn_output = self.attn(q, k, v)
    output, _ = self.o_proj(attn_output)
    return output


def _patched_qwen2moesparsemoeblock_forward(self, hidden_states: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
    """Patched forward that uses custom routing and handles FPM parameters."""
    # Store original routing function if it exists
    original_routing = getattr(self.experts, 'custom_routing_function', None)
    
    try:
        # Set our custom routing function to support expert masking and loss calculation
        if hasattr(self.experts, 'custom_routing_function'):
            self.experts.custom_routing_function = fpm_custom_routing_function
        
        # Call original forward method with FPM enhancements
        return _ORIGINAL_METHODS['Qwen2MoeSparseMoeBlock.forward'](self, hidden_states)
        
    finally:
        # Restore original routing function
        if original_routing is not None and hasattr(self.experts, 'custom_routing_function'):
            self.experts.custom_routing_function = original_routing


def _patched_qwen2moedecoderlayer_forward(self, positions: torch.Tensor, hidden_states: torch.Tensor, residual: Optional[torch.Tensor], gating_loss: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
    """
    Patched decoder layer forward that follows vLLM's expected signature and propagates gating loss.
    """
    # Self Attention
    if residual is None:
        residual = hidden_states
        hidden_states = self.input_layernorm(hidden_states)
    else:
        hidden_states, residual = self.input_layernorm(hidden_states, residual)
    
    # Use the corrected attention forward (only positions and hidden_states)
    hidden_states = self.self_attn(positions=positions, hidden_states=hidden_states)

    # Fully Connected
    hidden_states, residual = self.post_attention_layernorm(hidden_states, residual)
    
    layer_gating_loss = torch.tensor(0.0, device=hidden_states.device)
    if hasattr(self, 'mlp'):
        from vllm.model_executor.models.qwen2_moe import Qwen2MoeSparseMoeBlock
        if isinstance(self.mlp, Qwen2MoeSparseMoeBlock):
            hidden_states, layer_gating_loss = self.mlp(hidden_states)
            # Accumulate our FPM gating loss
            if _fpm_context.gating_loss is not None:
                layer_gating_loss = layer_gating_loss + _fpm_context.gating_loss
        else:
            hidden_states = self.mlp(hidden_states)

    return hidden_states, residual, gating_loss + layer_gating_loss


def _patched_qwen2moemodel_forward(self, input_ids: torch.Tensor, positions: torch.Tensor, intermediate_tensors: Optional = None, inputs_embeds: Optional[torch.Tensor] = None):
    """Patched model forward that correctly handles intermediate tensors and gating loss."""
    from vllm.distributed import get_pp_group
    from vllm.model_executor.layers.linear import LinearBase
    
    if get_pp_group().is_first_rank:
        if inputs_embeds is not None:
            hidden_states = inputs_embeds
        else:
            hidden_states = self.get_input_embeddings(input_ids)
        residual = None
        gating_loss = torch.tensor(0.0, device=hidden_states.device)
    else:
        assert intermediate_tensors is not None
        hidden_states = intermediate_tensors["hidden_states"]
        residual = intermediate_tensors["residual"]
        gating_loss = intermediate_tensors.get("gating_loss", torch.tensor(0.0, device=hidden_states.device))

    for layer in self.layers[self.start_layer:self.end_layer]:
        hidden_states, residual, gating_loss = layer(positions, hidden_states, residual, gating_loss)

    if not get_pp_group().is_last_rank:
        from vllm.model_executor.layers.linear import LinearBase
        return type('IntermediateTensors', (), {
            "get": lambda self, key, default=None: getattr(self, key, default),
            "hidden_states": hidden_states,
            "residual": residual,
            "gating_loss": gating_loss,
        })()
    
    hidden_states, _ = self.norm(hidden_states, residual)
    return hidden_states, gating_loss


def _patched_qwen2moeforcausallm_forward(self, input_ids, positions, kv_caches=None, attn_metadata=None, intermediate_tensors=None, inputs_embeds=None, **kwargs):
    """Patched forward that handles vLLM calling convention and extracts gating loss."""
    # Filter out vLLM-specific parameters that the original method doesn't accept
    forward_kwargs = {}
    if intermediate_tensors is not None:
        forward_kwargs['intermediate_tensors'] = intermediate_tensors
    if inputs_embeds is not None:
        forward_kwargs['inputs_embeds'] = inputs_embeds
    
    # Call the corrected model forward
    result = self.model(input_ids, positions, **forward_kwargs)
    
    # Handle different return types
    if isinstance(result, tuple) and len(result) == 2:
        hidden_states, gating_loss = result
    else:
        hidden_states = result
        gating_loss = _fpm_context.gating_loss if _fpm_context.gating_loss is not None else torch.tensor(0.0)
    
    # Add gating loss as router_loss to the final result (for compatibility)
    if hasattr(self, 'router_loss_attr'):
        setattr(self, 'router_loss_attr', gating_loss)
    
    return hidden_states


def apply_fpm_vllm_patch():
    """Apply all FPM patches to vLLM classes."""
    global _ORIGINAL_METHODS
    
    print("FPM-vLLM patch applied successfully. You can now load your DeepSpeed MoE model.")
    
    # 0. FORCE patch vllm-ascend MoE compatibility (must be first)
    _force_patch_ascend_forward_oot()
    
    # Import required vLLM modules
    from vllm.model_executor.models import qwen2_moe
    
    # 1. Patch get_config function to intercept config loading
    if 'get_config' not in _ORIGINAL_METHODS:
        try:
            from vllm.transformers_utils.config import get_config
            _ORIGINAL_METHODS['get_config'] = get_config
            
            # Create the patched function
            patched_get_config = _patched_get_config(get_config)
            
            # Replace the function in multiple modules
            import vllm.transformers_utils.config
            vllm.transformers_utils.config.get_config = patched_get_config
            
            # Also patch the imported reference in vllm.config
            import vllm.config
            vllm.config.get_config = patched_get_config
            
            print("[FPM Patch] ✅ get_config patched successfully in both modules")
        except Exception as e:
            print(f"[FPM Patch] ❌ Failed to patch get_config: {e}")
            import traceback
            traceback.print_exc()
    
    # 2. Patch Qwen2MoeForCausalLM.load_weights
    if 'Qwen2MoeForCausalLM.load_weights' not in _ORIGINAL_METHODS:
        try:
            _ORIGINAL_METHODS['Qwen2MoeForCausalLM.load_weights'] = qwen2_moe.Qwen2MoeForCausalLM.load_weights
            qwen2_moe.Qwen2MoeForCausalLM.load_weights = _patched_qwen2moeforcausallm_load_weights
            print("[FPM Patch] ✅ Qwen2MoeForCausalLM.load_weights patched successfully")
        except Exception as e:
            print(f"[FPM Patch] ❌ Failed to patch load_weights: {e}")
    
    # 3. Fix Qwen2MoeAttention.forward (corrects vLLM's incorrect implementation)
    if 'Qwen2MoeAttention.forward' not in _ORIGINAL_METHODS:
        try:
            _ORIGINAL_METHODS['Qwen2MoeAttention.forward'] = qwen2_moe.Qwen2MoeAttention.forward
            qwen2_moe.Qwen2MoeAttention.forward = _patched_qwen2moeattention_forward
            print("[FPM Patch] ✅ Qwen2MoeAttention.forward fixed and patched successfully")
        except Exception as e:
            print(f"[FPM Patch] ❌ Failed to patch attention forward: {e}")
    
    # 4. Patch Qwen2MoeSparseMoeBlock.forward
    if 'Qwen2MoeSparseMoeBlock.forward' not in _ORIGINAL_METHODS:
        try:
            _ORIGINAL_METHODS['Qwen2MoeSparseMoeBlock.forward'] = qwen2_moe.Qwen2MoeSparseMoeBlock.forward
            qwen2_moe.Qwen2MoeSparseMoeBlock.forward = _patched_qwen2moesparsemoeblock_forward
            print("[FPM Patch] ✅ Qwen2MoeSparseMoeBlock.forward patched successfully")
        except Exception as e:
            print(f"[FPM Patch] ❌ Failed to patch MoE forward: {e}")
    
    # 5. Patch Qwen2MoeDecoderLayer.forward (corrects the calling convention)
    if 'Qwen2MoeDecoderLayer.forward' not in _ORIGINAL_METHODS:
        try:
            _ORIGINAL_METHODS['Qwen2MoeDecoderLayer.forward'] = qwen2_moe.Qwen2MoeDecoderLayer.forward
            qwen2_moe.Qwen2MoeDecoderLayer.forward = _patched_qwen2moedecoderlayer_forward
            print("[FPM Patch] ✅ Qwen2MoeDecoderLayer.forward patched successfully")
        except Exception as e:
            print(f"[FPM Patch] ❌ Failed to patch decoder layer: {e}")
    
    # 6. Patch Qwen2MoeModel.forward
    if 'Qwen2MoeModel.forward' not in _ORIGINAL_METHODS:
        try:
            _ORIGINAL_METHODS['Qwen2MoeModel.forward'] = qwen2_moe.Qwen2MoeModel.forward
            qwen2_moe.Qwen2MoeModel.forward = _patched_qwen2moemodel_forward
            print("[FPM Patch] ✅ Qwen2MoeModel.forward patched successfully")
        except Exception as e:
            print(f"[FPM Patch] ❌ Failed to patch model forward: {e}")
    
    # 7. Patch Qwen2MoeForCausalLM.forward
    if 'Qwen2MoeForCausalLM.forward' not in _ORIGINAL_METHODS:
        try:
            _ORIGINAL_METHODS['Qwen2MoeForCausalLM.forward'] = qwen2_moe.Qwen2MoeForCausalLM.forward
            qwen2_moe.Qwen2MoeForCausalLM.forward = _patched_qwen2moeforcausallm_forward
            print("[FPM Patch] ✅ Qwen2MoeForCausalLM.forward patched successfully")
        except Exception as e:
            print(f"[FPM Patch] ❌ Failed to patch causal LM forward: {e}")
    
    # FINAL INSURANCE: Force patch vllm-ascend again after all other patches
    print("[FPM Patch] 🛡️  Final insurance: Force-patching vllm-ascend forward_oot again...")
    if not _force_patch_ascend_forward_oot():
        print("[FPM Patch] ⚠️  Final insurance patch failed, but continuing...")


def register_fpm_model(model_path: str):
    """Register a model path for FPM conversion.
    
    This tells the patch system that when this model path is loaded,
    it should be treated as an FPM model and have its config converted.
    """
    global _FPM_MODEL_PATHS
    _FPM_MODEL_PATHS.add(model_path)
    print(f"[FPM Patch] Registered model path for FPM conversion: {model_path}")
    print(f"[FPM Patch] Current registered paths: {_FPM_MODEL_PATHS}")


@contextmanager
def fpm_model_loading_context(model_path: str):
    """Context manager for loading FPM models with automatic config conversion.
    
    This registers the model path for conversion, yields control to the caller,
    and keeps the path registered for runtime FPM functionality.
    """
    register_fpm_model(model_path)
    try:
        yield
    finally:
        # KEEP the path registered for runtime FPM functionality
        # Don't unregister as the model may need FPM features during inference
        print(f"[FPM Patch] Keeping model path registered for runtime FPM features: {model_path}") 